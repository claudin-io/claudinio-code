# Stray Claude Code / agent session transcripts dumped into the repo root
[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-*.txt

# Agent skill bundles — third-party, reinstalled via `npx hyperframes skills update`
# and pinned by skills-lock.json; never vendored into history.
.agents/skills/
.claude/

# HyperFrames video projects: keep the source (storyboard, script, brief, frame
# spec, compositions), drop everything the pipeline regenerates.
videos/*/node_modules/
videos/*/renders/
videos/*/snapshots/
videos/*/assets/bgm/
videos/*/assets/voice/
videos/*/assets/fonts/
videos/*/assets/img/
videos/*/.hyperframes/frame-packets/
videos/*/.hyperframes/backup/
videos/*/.thumbnails/
videos/*/.media/
videos/*/.waveform-cache/
videos/*/assets/sfx/
videos/*/assets/logo.png
videos/*/capture/assets/
videos/*/audio_meta.json
videos/*/audio_engine_meta.json

# Local working copy of the MLX sidecar, which lives in its own repository
# (claudin-io/claudinio-mlx) so the Metal build — xcodebuild plus a ~690 MB
# toolchain component — stays out of this repo's release path. Kept here only
# for local rebuilds; the app consumes the pinned release, never this tree.
/mlx-sidecar/

# `mtplx tune` writes its per-depth logs and verdict here when run from the
# repo root.
outputs/
